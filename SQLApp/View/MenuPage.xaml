<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="SQLApp.View.MenuPage"
             Title="Menu Principal">
    <VerticalStackLayout Padding="30" Spacing="20" VerticalOptions="Center"
                         MaximumWidthRequest="400">
        <Label Text="SQLApp - Loja" FontSize="28" FontAttributes="Bold"
               HorizontalOptions="Center"/>

        <Button Text="Cadastro de Clientes" Clicked="btClientes_Clicked"/>
        <Button Text="Cadastro de Produtos" Clicked="btProdutos_Clicked"/>
        <Button Text="Compras" Clicked="btCompras_Clicked"/>
        <Button Text="Itens da Compra" Clicked="btItens_Clicked"/>
    </VerticalStackLayout>
</ContentPage>
